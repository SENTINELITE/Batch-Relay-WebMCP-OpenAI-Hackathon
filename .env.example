# The published Batch Relay API origin. Keep the default unless testing a local API.
BATCH_RELAY_API_BASE_URL=https://api.batchrelay.com

# Optional studio Test Mode configuration for published templates and sandbox assets.
# Never expose this token through NEXT_PUBLIC_* variables.
BATCH_RELAY_API_TOKEN=br_test_replace_me
BATCH_RELAY_STUDIO_ID=stu_replace_me
BATCH_RELAY_EVENT_ID=evt_replace_me

# Optional WebMCP telemetry/tracking key. Tools register locally without it.
NEXT_PUBLIC_WEBMCP_TRACKING_KEY=wmk_replace_me
