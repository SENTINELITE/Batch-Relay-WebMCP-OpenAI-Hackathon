# Dependencies and generated output are installed/generated in the image.
node_modules
.next
out

# Never send local credentials, provider endpoints, or journal data to the
# Docker build context. Runtime secrets are injected by Compose/orchestration.
.env
.env.*
.creative-data
*.log

# Repository metadata and local-only material are not needed to build Next.
.git
.gitignore
coverage
tests
docs
.webmcp
.DS_Store
