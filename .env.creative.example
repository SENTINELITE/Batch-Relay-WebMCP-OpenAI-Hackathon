# Private server-side Livepeer Creative MCP endpoint. Supply this only through
# an untracked deployment environment; never use NEXT_PUBLIC_ here.
LIVEPEER_MCP_URL=
# Optional bearer credential for the endpoint; leave unset for an authenticated gateway session.
LIVEPEER_API_KEY=

# The browser must establish this short-lived, httpOnly session before estimates/renders.
LIVEPEER_CREATIVE_PASSCODE=replace-me
LIVEPEER_SESSION_SECRET=replace-with-a-long-random-secret

# Compose mounts the persistent volume at /data/creative. The app fails closed
# when an absolute durable path is absent in production.
LIVEPEER_JOURNAL_PATH=/data/creative/journal.json
LIVEPEER_CREATIVE_BUDGET_USD=20
# Comma-separated HTTPS image hosts returned by the provider, when they differ from LIVEPEER_MCP_URL.
LIVEPEER_IMAGE_HOSTS=v3b.fal.media
